{
  "expo": {
    "name": "KITA-LOG",
    "slug": "kita-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kitalog",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arjizzy.KITALOG",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.arjizzy.KITALOG",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "4382662f-0fed-4ae2-99bb-ff76443d506d"
      }
    },
    "plugins": [
      "expo-font",
      "expo-dev-client",
      "@react-native-firebase/app"
    ]
  }
}